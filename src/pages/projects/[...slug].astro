---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p><a href={`${base}/projects`}>← Projects</a></p>
  <article>
    <h1>{entry.data.title}</h1>
    <p>
      {entry.data.status && <span class="tag">{entry.data.status}</span>}
      {entry.data.url && <a href={entry.data.url}>View project / source →</a>}
    </p>
    <Content />
  </article>
</Base>

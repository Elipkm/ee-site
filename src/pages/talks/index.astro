---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = (await getCollection('talks')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---
<Base title="Talks">
  <h1>Talks</h1>
  {items.length === 0 && <p>Talks, slides and recordings are coming soon.</p>}
  <div class="stack">{items.map((e) => (
    <a class="card" href={`${base}/talks/${e.id}`}>
      <p>{fmt(e.data.date)}{e.data.event && ` · ${e.data.event}`}</p>
      <h3>{e.data.title}</h3>
    </a>
  ))}</div>
</Base>

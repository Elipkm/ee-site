---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = (await getCollection('knowledge')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const topics = [...new Set(all.map((e) => e.data.topic))].sort();
---
<Base title="Knowledge">
  <h1>Knowledge base</h1>
  <p class="lead">Best practices and notes from day-to-day work.</p>
  {all.length === 0 && <p>No published notes yet.</p>}
  {topics.map((t) => (
    <section>
      <h2>{t}</h2>
      <div class="grid">{all.filter((e) => e.data.topic === t).map((e) => (
        <a class="card" href={`${base}/knowledge/${e.id}`}><h3>{e.data.title}</h3><p>{e.data.summary}</p><p class="date">Last edited {fmt(e.data.updated)}</p></a>
      ))}</div>
    </section>
  ))}
</Base>

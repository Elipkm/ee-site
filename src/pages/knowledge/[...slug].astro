---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('knowledge')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p><a href={`${base}/knowledge`}>← Knowledge</a></p>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="lead" style="font-size:.95rem">Created {fmt(entry.data.created)} · Last edited {fmt(entry.data.updated)}</p>
    <p>{entry.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
    <Content />
  </article>
</Base>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('recommendations')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const kinds = { book: 'Books', video: 'Videos', event: 'Events', tool: 'Tools' } as const;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icons = { book: '📚', video: '▶', event: '📍', tool: '🛠' } as const;

// Every card gets a visual: explicit `image` (URL or /path), else the YouTube thumbnail,
// else the site's logo (favicon), else an icon for the kind. `logo` = small centred tile.
function preview(url: string | undefined, image: string | undefined) {
  if (image) return { src: image.startsWith('/') ? base + image : image, logo: false };
  if (!url) return undefined;
  try {
    const u = new URL(url);
    let id: string | null = null;
    if (u.hostname === 'youtu.be') id = u.pathname.slice(1);
    else if (u.hostname.endsWith('youtube.com') && u.pathname === '/watch') id = u.searchParams.get('v');
    if (id) return { src: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`, logo: false };
    return { src: `https://www.google.com/s2/favicons?domain=${u.hostname}&sz=128`, logo: true };
  } catch { return undefined; }
}
---
<Base title="Recommendations">
  <h1>Recommendations</h1>
  {items.length === 0 && <p>Good books, videos and events are coming soon.</p>}
  {Object.entries(kinds).map(([k, label]) => {
    const list = items.filter((e) => e.data.kind === k);
    return list.length > 0 && (
      <section><h2>{label}</h2>
        <div class="grid">{list.map((e) => {
          const img = preview(e.data.url, e.data.image);
          const visual = img
            ? <img class={img.logo ? 'thumb logo' : 'thumb'} src={img.src} alt="" loading="lazy" />
            : <div class="thumb logo" aria-hidden="true">{icons[e.data.kind]}</div>;
          return (
            <div class="card media">
              {e.data.url ? <a href={e.data.url}>{visual}</a> : visual}
              <p class="date">Recommended {fmt(e.data.date)}</p>
              <h3>{e.data.url ? <a href={e.data.url}>{e.data.title}</a> : e.data.title}</h3>
              <p>{e.data.why}</p>
            </div>
          );
        })}</div>
      </section>
    );
  })}
</Base>
